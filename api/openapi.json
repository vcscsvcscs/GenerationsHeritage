                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Person hard deleted"
                    }
                }
            }
        },
        "/person/google/{google_id}": {
            "get": {
                "summary": "Get a person by Google ID",
